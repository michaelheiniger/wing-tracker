<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging of the desktop app (ADR 0023). The folder and the level come from DesktopLogging. -->
<configuration>
    <shutdownHook/>

    <define name="logDir" class="ch.qscqlmpa.wingtracker.desktop.LogDirectoryDefiner"/>
    <define name="logLevel" class="ch.qscqlmpa.wingtracker.desktop.LogLevelDefiner"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logDir}/wing-tracker.log</file>
        <!-- A new file per date in its name, and sooner when one grows too big; old ones go past the history or the cap. -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${logDir}/wing-tracker.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
            <!-- A desktop app is often closed before midnight, so old files are also cleaned when it starts. -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Kept so failures still reach a terminal and the system journal, as before there was a log file. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${logLevel}">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
